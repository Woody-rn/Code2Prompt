<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.npepub.ui.controller.DashboardController"
      prefWidth="950" prefHeight="650"
      stylesheets="@../css/style.css"
      styleClass="root">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="%app.title" styleClass="app-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%help.button" onAction="#onHelp" styleClass="small-button">
            <tooltip>
                <Tooltip text="%help.tooltip"/>
            </tooltip>
        </Button>
    </HBox>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.3">

        <fx:include fx:id="fileTree" source="file-tree.fxml"/>

        <VBox spacing="10" styleClass="content-panel">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%source.label" styleClass="field-label"/>
                <ComboBox fx:id="sourcePathField" editable="true" promptText="%source.prompt" prefWidth="370"/>
                <Button text="%browse.button" onAction="#onBrowseSource"/>
                <Button text="%open.folder.button" onAction="#onOpenSourceFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%output.label" styleClass="field-label"/>
                <TextField fx:id="outputPathField" promptText="%output.prompt" prefWidth="370"/>
                <Button text="%browse.button" onAction="#onBrowseOutput"/>
                <Button text="%open.folder.button" onAction="#onOpenOutputFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="startStopButton" text="%start.button" onAction="#onStartStop"
                        styleClass="start-button"/>
                <Button fx:id="chunkCardsButton" text="%results.button" onAction="#onToggleChunkCardsWindow"
                        styleClass="settings-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="%settings.button" onAction="#onOpenSettings" styleClass="settings-button"/>
                <Button fx:id="serverButton" text="%server.start.button" onAction="#onToggleServer"
                        styleClass="server-button-off"/>
                <Button text="🌐" onAction="#onOpenInBrowser" styleClass="settings-button">
                    <tooltip>
                        <Tooltip text="%server.open.browser.tooltip"/>
                    </tooltip>
                </Button>
            </HBox>

            <ProgressBar fx:id="progressBar" visible="false" prefWidth="Infinity"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%status.label" styleClass="section-label"/>
                <Label fx:id="statusLabel" text="%status.ready" styleClass="status-bar"/>
            </HBox>

            <Separator/>

            <VBox fx:id="promptSection" styleClass="prompt-section" spacing="8">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="taskCombo" HBox.hgrow="ALWAYS" promptText="%task.custom"/>
                    <Button text="💾" onAction="#onSaveTemplate" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%template.save.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="✏️" onAction="#onEditTemplate" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%template.edit.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="🗑" onAction="#onDeleteTemplate" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%template.delete.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="%prompt.apply.button" onAction="#onApplyPrompt" styleClass="apply-button">
                        <tooltip>
                            <Tooltip text="%prompt.apply.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="✨" onAction="#onImprovePrompt" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%prompt.improve.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="🔍" onAction="#onExpandPrompt" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%prompt.expand.tooltip"/>
                        </tooltip>
                    </Button>
                    <Button text="📝" onAction="#onGenerateTemplateName" styleClass="template-button">
                        <tooltip>
                            <Tooltip text="%prompt.name.tooltip"/>
                        </tooltip>
                    </Button>
                </HBox>
                <TextArea fx:id="promptField" prefRowCount="20" wrapText="true" promptText="%prompt.placeholder"/>
            </VBox>
        </VBox>

    </SplitPane>

</VBox>