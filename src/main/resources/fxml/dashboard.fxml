<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.npepub.ui.DashboardController"
      prefWidth="900" prefHeight="550"
      stylesheets="@../css/style.css"
      styleClass="root">

    <Label text="Code2Prompt" styleClass="app-title"/>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.3">

        <fx:include fx:id="fileTree" source="file-tree.fxml"/>

        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Папка-источник:" prefWidth="120"/>
                <TextField fx:id="sourcePathField" HBox.hgrow="ALWAYS" promptText="Выберите папку с проектом"/>
                <Button text="Обзор" onAction="#onBrowseSource"/>
                <Button text="📂" onAction="#onOpenSourceFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Папка вывода:" prefWidth="120"/>
                <TextField fx:id="outputPathField" HBox.hgrow="ALWAYS" promptText="Выберите папку для txt-файлов"/>
                <Button text="Обзор" onAction="#onBrowseOutput"/>
                <Button text="📂" onAction="#onOpenOutputFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Лимит символов:" prefWidth="120"/>
                <TextField fx:id="limitField" prefWidth="100" text="95000"/>
                <Button text="Настройки" onAction="#onOpenSettings" styleClass="settings-button"/>
                <Button text="📁 Логи" onAction="#onOpenLogs" styleClass="settings-button"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="startButton" text="СТАРТ" onAction="#onStart" styleClass="start-button"/>
                <Button fx:id="stopButton" text="СТОП" onAction="#onStop" visible="false" styleClass="stop-button"/>
                <Button fx:id="refreshButton" text="🔄 Обновить" onAction="#onRefresh"
                        styleClass="refresh-button" visible="false"/>
            </HBox>

            <ProgressBar fx:id="progressBar" visible="false" prefWidth="Infinity"/>

            <Label text="Результаты:" style="-fx-font-weight: bold;"/>
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
                <VBox fx:id="resultsBox" spacing="5"/>
            </ScrollPane>
        </VBox>

    </SplitPane>

    <Label fx:id="statusLabel" text="Готово" styleClass="status-bar"/>

</VBox>