<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.npepub.ui.DashboardController"
      prefWidth="900" prefHeight="550"
      stylesheets="@../css/style.css"
      styleClass="root">

    <Label text="%app.title" styleClass="app-title"/>

    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.3">

        <fx:include fx:id="fileTree" source="file-tree.fxml"/>

        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%source.label" prefWidth="120"/>
                <ComboBox fx:id="sourcePathField" HBox.hgrow="ALWAYS" editable="true" promptText="%source.prompt"/>
                <Button text="%browse.button" onAction="#onBrowseSource"/>
                <Button text="%open.folder.button" onAction="#onOpenSourceFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%output.label" prefWidth="120"/>
                <TextField fx:id="outputPathField" HBox.hgrow="ALWAYS" promptText="%output.prompt"/>
                <Button text="%browse.button" onAction="#onBrowseOutput"/>
                <Button text="%open.folder.button" onAction="#onOpenOutputFolder"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%limit.label" prefWidth="120"/>
                <TextField fx:id="limitField" prefWidth="100" text="95000"/>
                <Button text="%settings.button" onAction="#onOpenSettings" styleClass="settings-button"/>
                <Button text="%logs.button" onAction="#onOpenLogs" styleClass="settings-button"/>
                <Button fx:id="serverButton" text="%server.start.button" onAction="#onToggleServer" styleClass="settings-button"/>
                <Label fx:id="serverIndicator" text="●"/>
            </HBox>

            <Label text="%prompt.label" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="promptField" prefRowCount="3" wrapText="true" promptText="%prompt.placeholder"/>

            <HBox spacing="10">
                <Button fx:id="startButton" text="%start.button" onAction="#onStart" styleClass="start-button"/>
                <Button fx:id="stopButton" text="%stop.button" onAction="#onStop" visible="false" styleClass="stop-button"/>
            </HBox>

            <ProgressBar fx:id="progressBar" visible="false" prefWidth="Infinity"/>

            <Label text="%results.label" style="-fx-font-weight: bold;"/>
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
                <VBox fx:id="resultsBox" spacing="5"/>
            </ScrollPane>
        </VBox>

    </SplitPane>

    <Label fx:id="statusLabel" text="%status.ready" styleClass="status-bar"/>

</VBox>