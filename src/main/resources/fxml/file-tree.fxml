<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.npepub.ui.FileTreeController"
      VBox.vgrow="ALWAYS">

    <HBox spacing="2" alignment="CENTER_LEFT">
        <Label text="%tree.title" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📋" onAction="#onCopyTree" styleClass="small-button">
            <tooltip>
                <Tooltip text="%tree.copy.structure"/>
            </tooltip>
        </Button>
        <Button text="📄" onAction="#onCopySelectedFiles" styleClass="small-button">
            <tooltip>
                <Tooltip text="%tree.copy.selected"/>
            </tooltip>
        </Button>
        <Button text="▲" onAction="#onCollapseAll" styleClass="small-button">
            <tooltip>
                <Tooltip text="%tree.collapse.all"/>
            </tooltip>
        </Button>
        <Button text="▼" onAction="#onExpandAll" styleClass="small-button">
            <tooltip>
                <Tooltip text="%tree.expand.all"/>
            </tooltip>
        </Button>
    </HBox>

    <TreeView fx:id="fileTree" VBox.vgrow="ALWAYS" prefWidth="250"/>

</VBox>