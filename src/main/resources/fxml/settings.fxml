<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.npepub.ui.SettingsController"
            prefWidth="450"
            stylesheets="@../css/style.css">

    <content>
        <VBox spacing="15" styleClass="root">

            <!-- Модель, Лимит и Запас -->
            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Модель AI:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="modelCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Лимит символов:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="maxSymbolsField" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Запас (%):" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="safetyMarginField" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </VBox>
            </HBox>

            <!-- Папка вывода -->
            <VBox spacing="5">
                <Label text="Папка вывода по умолчанию:" style="-fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <TextField fx:id="defaultOutputPathField" HBox.hgrow="ALWAYS"/>
                    <Button text="Обзор" onAction="#onBrowseOutput"/>
                </HBox>
            </VBox>

            <!-- Разработчик -->
            <VBox spacing="5">
                <Label text="Разработчик" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="debugModeCheckBox" text="Режим отладки (окно с логами)"/>
                <Label text="Уровень логов:"/>
                <ComboBox fx:id="devLogLevelCombo" prefWidth="Infinity"/>
                <Button text="🗑 Очистить логи" onAction="#onClearLogs"/>
            </VBox>

            <!-- Исключённые папки и файлы (в два ряда) -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- Исключённые папки -->
                <VBox spacing="5" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <Label text="Исключённые папки (двойной клик — удалить):" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="excludedDirsList" prefHeight="250" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="5">
                        <TextField fx:id="newExcludedDirField" HBox.hgrow="ALWAYS" promptText="Название папки"/>
                        <Button text="➕" onAction="#onAddExcludedDir"/>
                    </HBox>
                </VBox>

                <!-- Исключённые файлы -->
                <VBox spacing="5" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <Label text="Исключённые файлы (двойной клик — удалить):" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="excludedFileNamesList" prefHeight="250" maxWidth="Infinity" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="5">
                        <TextField fx:id="newExcludedFileNameField" HBox.hgrow="ALWAYS" promptText="Имя файла"/>
                        <Button text="➕" onAction="#onAddExcludedFileName"/>
                    </HBox>
                </VBox>
            </HBox>

        </VBox>
    </content>

    <ButtonType text="Сохранить" buttonData="OK_DONE"/>
    <ButtonType text="Отмена" buttonData="CANCEL_CLOSE"/>

</DialogPane>