<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<DialogPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.npepub.ui.SettingsController"
            prefWidth="750" minWidth="650" prefHeight="520" minHeight="450"
            stylesheets="@../css/style.css">

    <content>
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <VBox spacing="15" HBox.hgrow="ALWAYS" minWidth="300" VBox.vgrow="ALWAYS">

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="%settings.model.label" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="modelCombo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="%settings.limit.label" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="maxSymbolsField"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="%settings.margin.label" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="safetyMarginField"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="%settings.output.label" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextField fx:id="defaultOutputPathField" HBox.hgrow="ALWAYS"/>
                        <Button text="%settings.browse" onAction="#onBrowseOutput"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="%settings.dev.label" style="-fx-font-weight: bold;"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <CheckBox fx:id="debugModeCheckBox" text="%settings.debug"/>
                        <Label text="%settings.log.level"/>
                        <ComboBox fx:id="devLogLevelCombo" prefWidth="120"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" VBox.vgrow="ALWAYS">
                    <VBox spacing="5" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <Label text="%settings.excluded.dirs" style="-fx-font-weight: bold;"/>
                        <ListView fx:id="excludedDirsList" VBox.vgrow="ALWAYS"/>
                        <HBox spacing="5">
                            <TextField fx:id="newExcludedDirField" HBox.hgrow="ALWAYS" promptText="%settings.excluded.dir.prompt"/>
                            <Button text="➕" onAction="#onAddExcludedDir"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <Label text="%settings.excluded.files" style="-fx-font-weight: bold;"/>
                        <ListView fx:id="excludedFileNamesList" VBox.vgrow="ALWAYS"/>
                        <HBox spacing="5">
                            <TextField fx:id="newExcludedFileNameField" HBox.hgrow="ALWAYS" promptText="%settings.excluded.file.prompt"/>
                            <Button text="➕" onAction="#onAddExcludedFileName"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button text="📤 Экспорт" onAction="#onExportConfig"/>
                    <Button text="📥 Импорт" onAction="#onImportConfig"/>
                    <Button text="%settings.reset.all" onAction="#onResetToDefaults"/>
                </HBox>

            </VBox>

            <VBox spacing="10" minWidth="300" VBox.vgrow="ALWAYS">
                <Label text="%settings.prompt.section" style="-fx-font-weight: bold; font-size: 14px;"/>

                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="%settings.prompt.system"/>
                    <TextArea fx:id="systemPromptField" VBox.vgrow="ALWAYS" wrapText="true"
                              promptText="%settings.prompt.system.prompt"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="%settings.prompt.part.prefix"/>
                    <TextField fx:id="partPrefixField"/>
                    <Label text="%settings.prompt.part.hint"
                           style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="%settings.prompt.final"/>
                    <TextField fx:id="finalPartField"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="%settings.prompt.separator"/>
                    <TextField fx:id="fileSeparatorField"/>
                </VBox>
            </VBox>

        </HBox>
    </content>

    <ButtonType text="%settings.save" buttonData="OK_DONE"/>
    <ButtonType text="%settings.cancel" buttonData="CANCEL_CLOSE"/>

</DialogPane>