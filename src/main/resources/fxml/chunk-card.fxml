<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.npepub.ui.ChunkCardController"
      spacing="10" alignment="CENTER_LEFT"
      styleClass="result-card">

    <Label fx:id="fileNameLabel" text="code2prompt_part1.txt" style="-fx-font-weight: bold;"/>
    <Label fx:id="sizeLabel" text="95 234 симв."/>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="openButton" text="%chunk.open" onAction="#onOpen" styleClass="card-button"/>
    <Button fx:id="copyButton" text="%chunk.copy" onAction="#onCopy" styleClass="card-button"/>
    <Label fx:id="copiedLabel" text="%chunk.copied" visible="false" style="-fx-text-fill: green;"/>

</HBox>